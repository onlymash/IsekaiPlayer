+                // Classic USM unsharp mask (negative range).
+                snprintf(shader, sizeof(shader),
+                    "//!HOOK OUTPUT\n"
+                    "//!BIND HOOKED\n"
+                    "//!DESC sharpen (classic USM, param=%.4f)\n"
+                    "vec4 hook() {\n"
+                    "    float st1 = 1.2;\n"
+                    "    vec4 p = HOOKED_tex(HOOKED_pos);\n"
+                    "    vec4 sum1 = HOOKED_texOff(st1 * vec2(+1, +1))\n"
+                    "              + HOOKED_texOff(st1 * vec2(+1, -1))\n"
+                    "              + HOOKED_texOff(st1 * vec2(-1, +1))\n"
