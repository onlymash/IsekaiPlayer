+                    "    color.rgb = clamp((float(lobe)*(card_sum+0.5*diag_sum)+base.rgb)*rcpL,0.0,1.0);\n"
+                    "    highp float blur9 = (b+d+f+h+g1+g2+g3+g4+e)*(1.0/9.0);\n"
+                    "    highp float usm_detail = e - blur9;\n"
+                    "    mediump float usm_str = %.6f;\n"
+                    "    mediump float rcas_luma = dot(color.rgb, vec3(0.299,0.587,0.114));\n"
+                    "    mediump float sharp_luma = clamp(rcas_luma+float(usm_detail)*usm_str,0.0,1.0);\n"
+                    "    color.rgb = (rcas_luma>1e-3) ? clamp(color.rgb*(sharp_luma/rcas_luma),0.0,1.0) : color.rgb;\n"
+                    "    mediump float mid_luma = float((mn1+mx1)*0.5);\n"
+                    "    mediump float valley = clamp((mid_luma-float(e))*8.0/max(float(mx1),0.1),0.0,1.0);\n"
