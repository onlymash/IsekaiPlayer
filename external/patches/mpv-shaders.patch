+                    "              + HOOKED_texOff(st2 * vec2(-1,  0))\n"
+                    "              + HOOKED_texOff(st2 * vec2( 0, -1));\n"
+                    "    vec4 t = p * 0.859375 + sum2 * -0.1171875 + sum1 * -0.09765625;\n"
+                    "    return p + t * %.6f;\n"
+                    "}\n",
+                    (double)sp, (double)sp);
+            } else {
+                // Positive range [0,5]: 9-tap FSR RCAS + Luma-Sharp USM +
