<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <!-- 1. Background Gradient -->
    <path android:pathData="M 0,0 L 512,0 L 512,512 L 0,512 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="512"
                android:endY="512"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item
                    android:color="@color/ic_playback_cover_background_start"
                    android:offset="0.0" />
                <item
                    android:color="@color/ic_playback_cover_background_middle"
                    android:offset="0.5" />
                <item
                    android:color="@color/ic_playback_cover_background_end"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. Main Array Group (Centered at 256, 256) -->
    <group
        android:translateX="256"
        android:translateY="256">
        <!-- Radial Ambient Glow -->
        <path android:pathData="M 0,-250 A 250,250 0 1,1 -0.1,-250 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:centerX="0"
                    android:centerY="0"
                    android:gradientRadius="250"
                    android:type="radial">
                    <item
                        android:color="@color/ic_playback_cover_aura_center"
                        android:offset="0.0" />
                    <item
                        android:color="@color/ic_playback_cover_aura_outer"
                        android:offset="0.55" />
                    <item
                        android:color="@color/ic_playback_cover_aura_fade"
                        android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Outer Track Ring -->
        <path
            android:fillColor="@android:color/transparent"
            android:pathData="M 0,-180 A 180,180 0 1,1 -0.1,-180 Z"
            android:strokeWidth="4.0"
            android:strokeColor="@color/ic_playback_cover_ring_primary" />

        <!-- Inner Track Ring -->
        <path
            android:fillColor="@android:color/transparent"
            android:pathData="M 0,-120 A 120,120 0 1,1 -0.1,-120 Z"
            android:strokeWidth="2.5"
            android:strokeColor="@color/ic_playback_cover_ring_secondary" />

        <!-- Cardinal Diamond Starbursts -->
        <path
            android:fillColor="@color/ic_playback_cover_rune_bright"
            android:pathData="M 215.0,0.0 L 180.0,10.0 L 168.0,0.0 L 180.0,-10.0 Z" />
        <path
            android:fillColor="@color/ic_playback_cover_rune_bright"
            android:pathData="M 0.0,215.0 L -10.0,180.0 L 0.0,168.0 L 10.0,180.0 Z" />
        <path
            android:fillColor="@color/ic_playback_cover_rune_bright"
            android:pathData="M -215.0,0.0 L -180.0,-10.0 L -168.0,0.0 L -180.0,10.0 Z" />
        <path
            android:fillColor="@color/ic_playback_cover_rune_bright"
            android:pathData="M 0.0,-215.0 L 10.0,-180.0 L 0.0,-168.0 L -10.0,-180.0 Z" />

        <!-- Diagonal Star Points -->
        <path
            android:fillColor="@color/ic_playback_cover_aux_accent"
            android:pathData="M 96.0,96.0 L 86.0,79.0 L 78.0,78.0 L 79.0,86.0 Z" />
        <path
            android:fillColor="@color/ic_playback_cover_aux_accent"
            android:pathData="M -96.0,96.0 L -79.0,86.0 L -78.0,78.0 L -86.0,79.0 Z" />
        <path
            android:fillColor="@color/ic_playback_cover_aux_accent"
            android:pathData="M -96.0,-96.0 L -86.0,-79.0 L -78.0,-78.0 L -79.0,-86.0 Z" />
        <path
            android:fillColor="@color/ic_playback_cover_aux_accent"
            android:pathData="M 96.0,-96.0 L 79.0,-86.0 L 78.0,-78.0 L 86.0,-79.0 Z" />

        <!-- Auxiliary Triangle -->
        <path
            android:fillColor="@android:color/transparent"
            android:pathData="M -100.00,0.00 L 50.00,86.60 L 50.00,-86.60 Z"
            android:strokeWidth="1.8"
            android:strokeColor="@color/ic_playback_cover_aux_line" />

        <!-- Core Play Triangle -->
        <path
            android:fillColor="@color/ic_playback_cover_play_triangle_fill"
            android:pathData="M 90.00,0.00 L -45.00,77.94 L -45.00,-77.94 Z" />
        <path
            android:fillColor="@android:color/transparent"
            android:pathData="M 90.00,0.00 L -45.00,77.94 L -45.00,-77.94 Z"
            android:strokeWidth="3.0"
            android:strokeColor="@color/ic_playback_cover_rune_bright" />

        <!-- Inner Kernel Triangle -->
        <path
            android:fillColor="@color/ic_playback_cover_core_highlight"
            android:pathData="M 40.00,0.00 L -20.00,34.64 L -20.00,-34.64 Z" />
    </group>

    <!-- 3. Stardust Particles -->
    <path
        android:fillColor="@color/ic_playback_cover_rune_star"
        android:pathData="M 60,220 A 3.0,3.0 0 1,1 59.9,220 Z" />
    <path
        android:fillColor="@color/ic_playback_cover_aux_star"
        android:pathData="M 420,100 A 3.5,3.5 0 1,1 419.9,100 Z" />
    <path
        android:fillColor="@color/ic_playback_cover_rune_star_bright"
        android:pathData="M 430,390 A 3.0,3.0 0 1,1 429.9,390 Z" />
    <path
        android:fillColor="@color/ic_playback_cover_star_white_bright"
        android:pathData="M 90,390 A 2.5,2.5 0 1,1 89.9,390 Z" />
</vector>
