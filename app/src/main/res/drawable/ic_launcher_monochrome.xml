<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- 保持一致的0.75倍缩放安全区 -->
    <group
        android:pivotX="512"
        android:pivotY="512"
        android:scaleX="0.75"
        android:scaleY="0.75">

        <!-- 外圈同心主轨圆环 -->
        <path
            android:fillColor="#00000000"
            android:pathData="M 512,182 A 330,330 0 1,1 511.9,182 Z"
            android:strokeWidth="14"
            android:strokeColor="#FFFFFF" />

        <!-- 八向符文刻度环 -->
        <!-- 上方两侧弧 -->
        <path
            android:fillColor="#00000000"
            android:pathData="M 608,249 A 280,280 0 0,1 710,314"
            android:strokeWidth="10"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round" />
        <path
            android:fillColor="#00000000"
            android:pathData="M 314,314 A 280,280 0 0,1 416,249"
            android:strokeWidth="10"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round" />

        <!-- 右侧两侧弧 -->
        <path
            android:fillColor="#00000000"
            android:pathData="M 766,416 A 280,280 0 0,1 784,512"
            android:strokeWidth="10"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round" />
        <path
            android:fillColor="#00000000"
            android:pathData="M 784,512 A 280,280 0 0,1 766,608"
            android:strokeWidth="10"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round" />

        <!-- 下方两侧弧 -->
        <path
            android:fillColor="#00000000"
            android:pathData="M 710,710 A 280,280 0 0,1 608,775"
            android:strokeWidth="10"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round" />
        <path
            android:fillColor="#00000000"
            android:pathData="M 416,775 A 280,280 0 0,1 314,710"
            android:strokeWidth="10"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round" />

        <!-- 左侧两侧弧 -->
        <path
            android:fillColor="#00000000"
            android:pathData="M 258,608 A 280,280 0 0,1 240,512"
            android:strokeWidth="10"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round" />
        <path
            android:fillColor="#00000000"
            android:pathData="M 240,512 A 280,280 0 0,1 258,416"
            android:strokeWidth="10"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round" />

        <!-- 4个正向魔导坐标星芒点 -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 512,142 L 522,182 L 512,222 L 502,182 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 512,802 L 522,842 L 512,882 L 502,842 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 142,512 L 182,522 L 222,512 L 182,502 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 802,512 L 842,522 L 882,512 L 842,502 Z" />

        <!-- 核心三角：采用 EvenOdd 缠绕规则，将内部小三角直接镂空挖除 -->
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M 400,320 L 730,512 L 400,704 Z M 470,440 L 590,512 L 470,584 Z" />
    </group>
</vector>