            android:strokeLineCap="round" />
        <path
            android:fillColor="#00000000"
            android:pathData="M 463.38,787.75 A 280,280 0 0,1 351.40,741.36"
            android:strokeWidth="10"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round" />
        <path
            android:fillColor="#00000000"
