    <string name="settings_decoder_scale_ewa_lanczos">EWA Lanczos (Jinc)</string>
    <string name="settings_decoder_scale_ewa_lanczos_summary">橢圓加權平均 Lanczos 縮放。速度較慢，但質量非常高。</string>
    <string name="settings_decoder_scale_lanczos">Lanczos</string>
    <string name="settings_decoder_scale_lanczos_summary">Lanczos 縮放。在質量和效能之間提供良好的平衡。</string>
    <string name="settings_decoder_scale_ewa_lanczos_sharp">EWA Lanczos Sharp</string>
    <string name="settings_decoder_scale_ewa_lanczos_sharp_summary">EWA Lanczos 的輕微銳化版本。高質量配置預設的預設值。</string>
    <string name="settings_decoder_scale_ewa_lanczos_4sharpest">EWA Lanczos 4Sharpest</string>
    <string name="settings_decoder_scale_ewa_lanczos_4sharpest_summary">非常銳利的縮放器，容易產生振鈴效應。在 gpu-next 上會自動開啟內建抗振鈴。</string>
    <string name="settings_decoder_scale_mitchell">Mitchell-Netravali</string>
    <string name="settings_decoder_scale_mitchell_summary">分段三次過濾器。在所有縮放偽影之間提供平衡的折衷。</string>
    <string name="settings_decoder_scale_hermite">Hermite</string>
    <string name="settings_decoder_scale_hermite_summary">Hermite 樣條。非常快，但容易產生塊狀感。</string>
    <string name="settings_decoder_scale_catmull_rom">Catmull-Rom</string>
    <string name="settings_decoder_scale_catmull_rom_summary">比 Mitchell 更銳利，但容易產生振鈴效應。</string>
    <string name="settings_decoder_scale_oversample">Oversample</string>
    <string name="settings_decoder_scale_oversample_summary">畫素超取樣以消除抖動偽影，但會增加一些模糊。</string>

    <string name="settings_decoder_deband">去色帶 (Debanding)</string>
    <string name="settings_decoder_deband_summary">減少影片中的色彩斷層（色帶）現象</string>
    <string name="settings_decoder_deband_iterations">迭代次數 (Iterations)</string>
    <string name="settings_decoder_deband_iterations_summary">每個樣本執行的去色帶步數。值越高效果越好，但更耗效能。(預設: 1)</string>
    <string name="settings_decoder_deband_threshold">閾值 (Threshold)</string>
    <string name="settings_decoder_deband_threshold_summary">濾鏡的截止閾值。較高的數值會顯著增強去色帶強度，但會逐漸減少影像細節。(預設: 48)</string>
    <string name="settings_decoder_deband_range">範圍 (Range)</string>
    <string name="settings_decoder_deband_range_summary">濾鏡的初始半徑。半徑越高能找到更多漸變，半徑越低平滑效果越激進。(預設: 16)</string>
    <string name="settings_decoder_deband_grain">噪點 (Grain)</string>
    <string name="settings_decoder_deband_grain_summary">新增額外的噪點以掩蓋殘留的量化偽影。(預設: 32)</string>

